# ---------------------------------------------------------------------------
# ShadowSpark Courier — environment variables (all optional at build time)
# ---------------------------------------------------------------------------

# Prisma/PostgreSQL — real backend only. NEVER queried during `next build`.
DATABASE_URL="postgresql://shadowspark:change_me@localhost:5432/delivery_parcel?schema=public"

# ---------- AI agent (optional) ----------
# When OPENAI_API_KEY is set the /api/chat agent uses a real LLM; when empty it
# falls back to the bundled rule-based MockLLM (works offline, same interface).
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ---------- Payments (optional) ----------
# Paystack secret enables live checkout; without it the booking UI stays in demo.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# ---------- Maps (optional) ----------
# Render a live Mapbox map when set; otherwise a stylized static placeholder.
NEXT_PUBLIC_MAPBOX_TOKEN=""
